{
  "name": "@streamlit-shadcn-ui/frontend-v2",
  "version": "0.1.19",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "22.20.0",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "build": "pnpm run check:generated && tsc --noEmit && vite build && node scripts/verify-dist.mjs",
    "build:watch": "vite build --watch --mode development",
    "capture:registry": "node scripts/capture-registry.mjs",
    "check": "pnpm run test && pnpm run build",
    "check:generated": "node scripts/generate-from-vendored-registry.mjs --check && node scripts/verify-generated-source.mjs && node scripts/verify-import-graph.mjs",
    "generate": "node scripts/generate-from-vendored-registry.mjs --write",
    "test": "pnpm run test:unit && pnpm run test:css",
    "test:css": "node scripts/test-shadow-css.mjs",
    "test:e2e": "playwright test",
    "test:e2e:wave1": "SSUI_V2_E2E_APP=V2_POC.py SSUI_V2_E2E_SUITE=wave1 playwright test",
    "test:e2e:wave2": "SSUI_V2_E2E_APP=V2_WAVE2.py SSUI_V2_E2E_SUITE=wave2 playwright test",
    "test:e2e:wave3": "SSUI_V2_E2E_APP=V2_WAVE3.py SSUI_V2_E2E_SUITE=wave3 playwright test",
    "test:e2e:wave4": "SSUI_V2_E2E_APP=V2_WAVE4.py SSUI_V2_E2E_SUITE=wave4 playwright test",
    "test:e2e:wave5": "SSUI_V2_E2E_APP=V2_WAVE5.py SSUI_V2_E2E_SUITE=wave5 playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@streamlit/component-v2-lib": "0.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.12.1",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "postcss-selector-parser": "7.1.4",
    "postcss-value-parser": "4.2.0",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "ts-morph": "28.0.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
